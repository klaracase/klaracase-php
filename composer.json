{
    "name": "klaracase/klaracase",
    "description": "Official PHP client for the Klaracase REST API: German court decisions, statutes and citation checks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "klaracase",
        "german law",
        "german case law",
        "rechtsprechung",
        "gesetze",
        "statutes",
        "legal research",
        "citation check",
        "mcp",
        "api client",
        "psr-18"
    ],
    "homepage": "https://klaracase.de/developers?ref=packagist",
    "support": {
        "issues": "https://github.com/klaracase/klaracase-php/issues",
        "source": "https://github.com/klaracase/klaracase-php",
        "email": "support@klaracase.de",
        "docs": "https://klaracase.de/docs/api"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "ext-mbstring": "*",
        "php-http/discovery": "^1.19",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.0 || ^2.0 || ^3.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "laravel/pint": "^1.18",
        "nyholm/psr7": "^1.8",
        "php-http/mock-client": "^1.6",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "guzzlehttp/guzzle": "A PSR-18 client. With it the client timeout and the per-call `RequestOptions::with(timeout:)` take effect.",
        "nyholm/psr7": "PSR-7 and PSR-17 implementation, found through php-http/discovery.",
        "symfony/http-client": "Another PSR-18 client (use its Psr18Client with nyholm/psr7). Its timeout exceptions are recognised.",
        "php-http/guzzle7-adapter": "Guzzle 7 as an Httplug client, for projects that already use Httplug."
    },
    "autoload": {
        "psr-4": {
            "Klaracase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Klaracase\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.99"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "smoke": "@php scripts/smoke.php",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
